FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY --from=monolith . .
RUN dotnet test tests/Cinema.OrdersTests/Cinema.OrdersTests.csproj --filter FullyQualifiedName~OrderCheckoutCharacterizationTests --artifacts-path /artifacts
RUN dotnet publish src/Host/Cinema.Api/Cinema.Api.csproj -c Release -o /app --artifacts-path /artifacts /p:UseAppHost=false
RUN dotnet publish src/Tools/Cinema.DbUpdater/Cinema.DbUpdater.csproj -c Release -o /updater --artifacts-path /artifacts /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app .
COPY --from=build /updater /updater
ENTRYPOINT ["dotnet", "Cinema.Api.dll"]
