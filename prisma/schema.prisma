generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Transport retry budget; business idempotency remains in processed_events/grants.
// Quarantine bytes contain the original private event and require restricted access.
model InboundDelivery {
  id                 String    @id @db.VarChar(64)
  operation          String    @db.VarChar(32)
  sourceQueue        String    @map("source_queue") @db.VarChar(255)
  attempts           Int       @default(0)
  maxAttempts        Int       @default(3) @map("max_attempts")
  nextAttemptAt      DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz()
  leaseToken         String?   @map("lease_token") @db.Uuid
  leaseExpiresAt     DateTime? @map("lease_expires_at") @db.Timestamptz()
  completedAt        DateTime? @map("completed_at") @db.Timestamptz()
  quarantineRequired Boolean   @default(false) @map("quarantine_required")
  quarantinedAt      DateTime? @map("quarantined_at") @db.Timestamptz()
  errorCode          String?   @map("error_code") @db.VarChar(64)
  originalBody       Bytes?    @map("original_body")
  originalProperties Bytes?    @map("original_properties")
  replayId           String?   @map("replay_id") @db.Uuid
  replayCount        Int       @default(0) @map("replay_count")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([quarantinedAt])
  @@map("inbound_deliveries")
}

enum Tier {
  BRONZE
  SILVER
  GOLD
}

model LoyaltyProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  tier Tier @default(BRONZE)

  balance        Int @default(0)
  lifetimePoints Int @default(0) @map("lifetime_points")
  yearPoints     Int @default(0) @map("year_points")
  yearVisits     Int @default(0) @map("year_visits")

  tierExpiresAt            DateTime? @map("tier_expires_at") @db.Timestamptz()
  lastActivityAt           DateTime? @map("last_activity_at") @db.Timestamptz()
  balanceExpiresAt         DateTime? @map("balance_expires_at") @db.Timestamptz()
  birthdayDate             DateTime? @map("birthday_date") @db.Date
  lastExpiryNotificationAt DateTime? @map("last_expiry_notification_at") @db.Timestamptz()

  goldUpgradeUsedMonth String? @map("gold_upgrade_used_month") @db.VarChar(7)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([userId])
  @@index([tier])
  @@map("loyalty_profiles")
}

model ProcessedEvent {
  eventId      String   @id @map("event_id") @db.VarChar(128)
  processedAt  DateTime @default(now()) @map("processed_at") @db.Timestamptz()
  operation    String?  @db.VarChar(16)
  userId       String?  @map("user_id") @db.Uuid
  orderId      String?  @map("order_id") @db.Uuid
  amount       Int?
  balanceAfter Int?     @map("balance_after")

  @@map("processed_events")
}

model PointsTransaction {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  type         String   @db.VarChar(20)
  points       Int
  balanceAfter Int      @map("balance_after")
  orderId      String?  @map("order_id") @db.Uuid
  description  String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  checkoutDebit  CheckoutDebit? @relation("CheckoutDebit")
  checkoutRefund CheckoutDebit? @relation("CheckoutRefund")

  @@index([userId])
  @@index([createdAt])
  @@map("points_transactions")
}

model CheckoutDebit {
  debitId  String  @id @map("debit_id") @db.Uuid
  refundId String? @unique @map("refund_id") @db.Uuid

  debit  PointsTransaction  @relation("CheckoutDebit", fields: [debitId], references: [id], onDelete: Restrict)
  refund PointsTransaction? @relation("CheckoutRefund", fields: [refundId], references: [id], onDelete: Restrict)

  @@map("checkout_debits")
}

model GoldUpgradeReservation {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  month      String    @db.VarChar(7)
  orderId    String?   @map("order_id") @db.Uuid
  releasedAt DateTime? @map("released_at") @db.Timestamptz()

  @@unique([userId, orderId])
  // Active user/month uniqueness is a partial index in migration SQL.
  @@map("gold_upgrade_reservations")
}

model UserBonusGrant {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  type                String   @db.VarChar(32)
  grantYear           Int      @map("grant_year") @db.SmallInt
  points              Int
  pointsTransactionId String?  @unique @map("points_transaction_id") @db.Uuid
  grantedAt           DateTime @default(now()) @map("granted_at") @db.Timestamptz()

  @@unique([userId, type, grantYear])
  @@index([userId])
  @@map("user_bonus_grants")
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model OutboxEvent {
  id             String            @id @default(uuid()) @db.Uuid
  type           String            @db.VarChar(100)
  payload        Json              @db.JsonB
  status         OutboxEventStatus @default(PENDING)
  aggregateType  String            @map("aggregate_type") @db.VarChar(100)
  aggregateId    String            @map("aggregate_id") @db.Uuid
  attempts       Int               @default(0) @db.SmallInt
  maxAttempts    Int               @default(5) @map("max_attempts") @db.SmallInt
  error          String?           @db.Text
  publishedAt    DateTime?         @map("published_at") @db.Timestamptz()
  leaseToken     String?           @map("lease_token") @db.Uuid
  leaseExpiresAt DateTime?         @map("lease_expires_at") @db.Timestamptz()
  nextAttemptAt  DateTime          @default(now()) @map("next_attempt_at") @db.Timestamptz()
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([status, createdAt])
  @@index([status, nextAttemptAt, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

enum AchievementCategory {
  VISITS
  SPENDING
  TIER
  TIME
  SPECIAL
  STREAK
  SECRET
}

model AchievementDispatchIntent {
  id            String    @id @default(uuid()) @db.Uuid
  eventId       String    @map("event_id") @db.VarChar(91)
  userId        String    @map("user_id") @db.Uuid
  actionType    String    @map("action_type") @db.VarChar(40)
  payload       Json      @db.JsonB
  deliveredAt   DateTime? @map("delivered_at") @db.Timestamptz()
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz()
  error         String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([userId, eventId, actionType])
  @@index([deliveredAt, nextAttemptAt])
  @@map("achievement_dispatch_intents")
}

enum AchievementRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum AchievementStrategy {
  INSTANT
  THRESHOLD
  STREAK
}

model Achievement {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(64)

  name        String  @db.VarChar(128)
  description String  @db.Text
  secretHint  String? @map("secret_hint") @db.Text
  isSecret    Boolean @default(false) @map("is_secret")

  icon     String              @db.VarChar(128)
  category AchievementCategory
  rarity   AchievementRarity   @default(COMMON)
  strategy AchievementStrategy @default(INSTANT)

  criteria Json @db.JsonB

  rewardPoints Int     @default(0) @map("reward_points")
  sortOrder    Int     @default(0) @map("sort_order") @db.SmallInt
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  userAchievements UserAchievement[]

  @@index([category])
  @@index([isActive])
  @@map("achievements")
}

model UserAchievement {
  id            String @id @default(uuid()) @db.Uuid
  userId        String @map("user_id") @db.Uuid
  achievementId String @map("achievement_id") @db.Uuid

  current Int @default(0) @db.Integer
  target  Int @default(1) @db.Integer

  isUnlocked Boolean   @default(false) @map("is_unlocked")
  unlockedAt DateTime? @map("unlocked_at") @db.Timestamptz()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([userId, isUnlocked])
  @@index([achievementId])
  @@map("user_achievements")
}
